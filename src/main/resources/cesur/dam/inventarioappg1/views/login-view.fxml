<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>


<BorderPane minHeight="300.0" minWidth="300.0" styleClass="login-root" stylesheets="@../style.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cesur.dam.inventarioappg1.controllers.LoginController">
   <center>
      <VBox alignment="CENTER" spacing="20.0">
         <children>
            <Label styleClass="login-title" text="Bienvenido a InventarioAPPG1" />
            <Button mnemonicParsing="false" onAction="#login" styleClass="login-button" text="Login">
               <padding>
                  <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
               </padding>
            </Button>
         </children>
      </VBox>
   </center>
</BorderPane>
